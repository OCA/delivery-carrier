<odoo>
    <record id="view_picking_form_inherit_partner_delivery_schedule" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.partner.delivery.schedule</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div
                    invisible="not partner_delivery_schedule_warning"
                    class="alert alert-warning"
                    role="alert"
                >
                    <field
                        name="partner_delivery_schedule_warning"
                        readonly="1"
                        force_save="1"
                    />
                </div>
                <div
                    invisible="not partner_pickings_schedule_info"
                    class="alert alert-info"
                    role="alert"
                >
                    <field
                        name="partner_pickings_schedule_info"
                        readonly="1"
                        force_save="1"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
