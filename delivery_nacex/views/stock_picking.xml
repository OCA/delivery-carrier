<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_nacex" model="ir.ui.view">
        <field name="name">stock.picking.form.nacex</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="carrier_id" position="after">
                <field name="nacex_with_return" invisible="carrier_id.delivery_type != 'nacex'"/>
            </field>
        </field>
    </record>
</odoo>
