<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_dpd_carrier_account_form" model="ir.ui.view">
        <field name="model">carrier.account</field>
        <field
            name="inherit_id"
            ref="delivery_carrier_account.carrier_account_view_form"
        />
        <field name="arch" type="xml">
            <field name="password" position="after">
                <field
                    name="dpd_fr_customer_country"
                    invisible="delivery_type != 'dpd_fr'"
                    required="delivery_type == 'dpd_fr'"
                />
                <field
                    name="dpd_fr_customer_id"
                    invisible="delivery_type != 'dpd_fr'"
                    required="delivery_type == 'dpd_fr'"
                />
                <field
                    name="dpd_fr_agency_id"
                    invisible="delivery_type != 'dpd_fr'"
                    required="delivery_type == 'dpd_fr'"
                />
                <field
                    name="dpd_fr_file_format"
                    invisible="delivery_type != 'dpd_fr'"
                    required="delivery_type == 'dpd_fr'"
                />
            </field>
        </field>
    </record>

</odoo>
