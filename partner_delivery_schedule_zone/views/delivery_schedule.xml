<odoo>
    <record id="view_delivery_schedule_form_zone" model="ir.ui.view">
        <field name="name">delivery.schedule.form.zone</field>
        <field name="model">delivery.schedule</field>
        <field
            name="inherit_id"
            ref="partner_delivery_schedule.view_partner_delivery_schedule_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Delivery Zones">
                    <field
                        name="delivery_zone_ids"
                        widget="many2many_tags"
                        nolabel="1"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
