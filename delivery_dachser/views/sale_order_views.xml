<odoo>
    <!-- Breakdown in the "Add a shipping method" wizard (choose.delivery.carrier) -->
    <record id="choose_delivery_carrier_view_form_inherit_dachser" model="ir.ui.view">
        <field name="name">choose.delivery.carrier.form.inherit.dachser</field>
        <field name="model">choose.delivery.carrier</field>
        <field name="inherit_id" ref="delivery.choose_delivery_carrier_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <field name="is_dachser_carrier" invisible="1" />
                <group
                    string="Dachser Quotation Breakdown"
                    invisible="not is_dachser_carrier or not dachser_rate_breakdown"
                >
                    <group>
                        <field name="dachser_estimated_cost" />
                        <field name="dachser_chargeable_weight" />
                    </group>
                    <group>
                        <field name="dachser_rate_breakdown" nolabel="1" colspan="2" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Dachser Internal Cost Information on Sales Order -->
    <record id="view_order_form_inherit_dachser" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.dachser</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']" position="inside">
                <field
                    name="dachser_estimated_cost"
                    invisible="not dachser_estimated_cost"
                    readonly="1"
                />
                <field
                    name="dachser_chargeable_weight"
                    invisible="not dachser_chargeable_weight"
                    readonly="1"
                />
                <field
                    name="dachser_quotation_id"
                    invisible="not dachser_quotation_id"
                    readonly="1"
                />
                <field
                    name="dachser_rate_breakdown"
                    invisible="not dachser_rate_breakdown"
                    readonly="1"
                />
            </xpath>
        </field>
    </record>
</odoo>
