<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_package_type_form" model="ir.ui.view">
        <field name="name">stock.package.carrier.id.form</field>
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='package_carrier_type']" position="after">
                <field
                    name="allowed_package_carrier_ids"
                    widget="many2many_tags"
                    domain="[('delivery_type', '=', package_carrier_type)] if package_carrier_type != 'none' else []"
                />
            </xpath>
        </field>
    </record>
</odoo>
