<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="delivery_carrier_form_view">
        <field
            name="name"
        >delivery.carrier.form (in delivery_carrier_tracking_url_clickable)</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <field name="default_tracking_url" position="after">
                <field name="tracking_number_separator" />
            </field>
        </field>
    </record>

</odoo>
