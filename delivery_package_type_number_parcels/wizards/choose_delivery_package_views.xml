<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="choose_delivery_package_view_form" model="ir.ui.view">
        <field
            name="name"
        >stock.put.in.pack.form (in delivery_package_type_number_parcels)</field>
        <field name="model">stock.put.in.pack</field>
        <field name="inherit_id" ref="stock_delivery.stock_put_in_pack_form" />
        <field name="arch" type="xml">
            <field name="package_type_id" position="after">
                <field name="number_of_parcels" invisible="number_of_parcels == 0" />
            </field>
        </field>
    </record>
</odoo>
