<odoo>
    <record model="ir.ui.view" id="partner_delivery_zone_tree_view">
        <field
            name="name"
        >partner.delivery.zone.tree (in partner_delivery_zone_zip)</field>
        <field name="model">partner.delivery.zone</field>
        <field
            name="inherit_id"
            ref="partner_delivery_zone.view_partner_delivery_zone_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="editable" />
            </xpath>
        </field>
    </record>

    <record id="view_partner_delivery_zone_form" model="ir.ui.view">
        <field name="name">partner.delivery.zone.form</field>
        <field name="model">partner.delivery.zone</field>
        <field name="arch" type="xml">
            <form string="Delivery Zone">
                <group>
                    <group>
                        <field name="code" />
                        <field name="name" />
                    </group>

                    <group>
                        <field name="active" />
                    </group>
                </group>

                <group>
                    <field name="zip_ids">
                        <list editable="bottom">
                            <field name="name" />
                        </list>
                    </field>
                </group>
            </form>
        </field>
    </record>

    <record
        id="partner_delivery_zone.partner_delivery_zone_action"
        model="ir.actions.act_window"
    >
        <field name="view_mode">list,form</field>
    </record>
</odoo>
