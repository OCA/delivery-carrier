<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_package_view_form" model="ir.ui.view">
        <field name="name">stock.package.form.inherit.tracking</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_form" />
        <field name="arch" type="xml">
            <field name="package_type_id" position="after">
                <field name="carrier_tracking_ref" />
                <field
                    name="carrier_tracking_url"
                    widget="url"
                    invisible="not carrier_tracking_url"
                />
            </field>
        </field>
    </record>

    <record id="stock_package_view_list" model="ir.ui.view">
        <field name="name">stock.package.list.inherit.tracking</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_list" />
        <field name="arch" type="xml">
            <field name="package_type_id" position="after">
                <field name="carrier_tracking_ref" optional="show" />
            </field>
        </field>
    </record>

    <record id="stock_package_view_list_editable" model="ir.ui.view">
        <field name="name">stock.package.list.editable.inherit.tracking</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_list_editable" />
        <field name="arch" type="xml">
            <field name="package_type_id" position="after">
                <field name="carrier_tracking_ref" />
                <field name="carrier_tracking_url" widget="url" optional="show" />
            </field>
        </field>
    </record>
</odoo>
