<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sendcloud_return_form" model="ir.ui.view">
        <field name="name">sendcloud.return.form.return.portal</field>
        <field name="model">sendcloud.return</field>
        <field
            name="inherit_id"
            ref="delivery_sendcloud_oca.view_sendcloud_return_form"
        />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_create_odoo_return"
                    type="object"
                    string="Create Return Operation"
                    class="btn-primary"
                    invisible="picking_id"
                />
            </header>
            <field name="incoming_parcel_id" position="after">
                <field name="original_picking_id" />
                <field name="picking_id" />
                <field
                    name="odoo_return_error"
                    invisible="not odoo_return_error"
                    class="text-danger"
                />
            </field>
        </field>
    </record>
</odoo>
