<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_sendcloud_sync_returns" model="ir.cron">
        <field name="name">Sendcloud: Sync Returns</field>
        <field name="model_id" ref="delivery_sendcloud_oca.model_sendcloud_return" />
        <field name="state">code</field>
        <field name="code">model.sendcloud_sync_returns()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="ir_cron_sendcloud_check_cancelled_parcels" model="ir.cron">
        <field name="name">Sendcloud: Check Cancelled Parcels</field>
        <field name="model_id" ref="delivery_sendcloud_oca.model_sendcloud_parcel" />
        <field name="state">code</field>
        <field name="code">model.sendcloud_check_cancelled_parcels()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
