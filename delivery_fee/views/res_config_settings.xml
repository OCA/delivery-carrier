<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_sale" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='shipping_setting_container']/setting[@id='delivery']"
                position="after"
            >
                <setting
                    id="display_delivery_fee_settings"
                    company_dependent="1"
                    help="Apply the delivery fee only once per sales order."
                >
                    <field name="one_delivery_fee_by_sale_order" />
                </setting>
                <setting
                    id="display_delivery_fee_commercial_partner_day_settings"
                    company_dependent="1"
                    help="Apply the delivery fee only once per commercial partner and day."
                >
                    <field name="one_delivery_fee_by_commercial_partner_day" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
