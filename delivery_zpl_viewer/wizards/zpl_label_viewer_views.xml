<odoo>
    <record id="delivery_zpl_label_viewer_view_form" model="ir.ui.view">
        <field name="name">delivery.zpl.label.viewer.form</field>
        <field name="model">delivery.zpl.label.viewer</field>
        <field name="arch" type="xml">
            <form string="ZPL Labels">
                <field name="picking_id" invisible="1" />
                <field name="label_count" invisible="1" />
                <group>
                    <group>
                        <field
                            name="attachment_id"
                            widget="radio"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field
                            name="label_index"
                            attrs="{'invisible': [('label_count', '&lt;', 2)]}"
                        />
                    </group>
                    <group>
                        <div
                            class="alert alert-warning"
                            role="alert"
                            colspan="2"
                            attrs="{'invisible': [('preview_error', '=', False)]}"
                        >
                            <field name="preview_error" nolabel="1" />
                        </div>
                        <field
                            name="preview_image"
                            widget="image"
                            nolabel="1"
                            colspan="2"
                            readonly="1"
                            options="{'size': [0, 600]}"
                            attrs="{'invisible': [('preview_image', '=', False)]}"
                        />
                    </group>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
