<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_fedex_rest_carrier_account_form" model="ir.ui.view">
        <field name="model">carrier.account</field>
        <field
            name="inherit_id"
            ref="delivery_carrier_account.carrier_account_view_form"
        />
        <field name="arch" type="xml">
            <field name="password" position="after">
                <field
                    name="fedex_rest_account_number"
                    attrs="{'invisible': [('delivery_type', '!=', 'fedex_rest')], 'required': [('delivery_type', '=', 'fedex_rest')]}"
                />
                <field
                    name="fedex_rest_file_format"
                    attrs="{'invisible': [('delivery_type', '!=', 'fedex_rest')], 'required': [('delivery_type', '=', 'fedex_rest')]}"
                />
                <field
                    name="fedex_rest_label_stock_type"
                    attrs="{'invisible': [('delivery_type', '!=', 'fedex_rest')], 'required': [('delivery_type', '=', 'fedex_rest')]}"
                />
                <field
                    name="fedex_rest_doc_tab_content_type"
                    attrs="{'invisible': ['|', ('delivery_type', '!=', 'fedex_rest'), ('fedex_rest_label_stock_type', 'not in', ['STOCK_4X675_LEADING_DOC_TAB', 'STOCK_4X675_TRAILING_DOC_TAB'])]}"
                />
                <field
                    name="fedex_rest_pickup_type"
                    attrs="{'invisible': [('delivery_type', '!=', 'fedex_rest')], 'required': [('delivery_type', '=', 'fedex_rest')]}"
                />
                <field
                    name="fedex_rest_duties_payment_type"
                    attrs="{'invisible': [('delivery_type', '!=', 'fedex_rest')], 'required': [('delivery_type', '=', 'fedex_rest')]}"
                />
                <field
                    name="fedex_rest_use_etd"
                    attrs="{'invisible': [('delivery_type', '!=', 'fedex_rest')]}"
                />
                <field
                    name="fedex_rest_notify_recipient"
                    attrs="{'invisible': [('delivery_type', '!=', 'fedex_rest')]}"
                />
                <field
                    name="fedex_rest_notify_on_shipment"
                    attrs="{'invisible': ['|', ('delivery_type', '!=', 'fedex_rest'), ('fedex_rest_notify_recipient', '=', False)]}"
                />
                <field
                    name="fedex_rest_notify_on_tender"
                    attrs="{'invisible': ['|', ('delivery_type', '!=', 'fedex_rest'), ('fedex_rest_notify_recipient', '=', False)]}"
                />
                <field
                    name="fedex_rest_notify_on_estimated_delivery"
                    attrs="{'invisible': ['|', ('delivery_type', '!=', 'fedex_rest'), ('fedex_rest_notify_recipient', '=', False)]}"
                />
                <field
                    name="fedex_rest_notify_on_exception"
                    attrs="{'invisible': ['|', ('delivery_type', '!=', 'fedex_rest'), ('fedex_rest_notify_recipient', '=', False)]}"
                />
                <field
                    name="fedex_rest_notify_on_delivery"
                    attrs="{'invisible': ['|', ('delivery_type', '!=', 'fedex_rest'), ('fedex_rest_notify_recipient', '=', False)]}"
                />
                <field
                    name="fedex_rest_notification_message"
                    attrs="{'invisible': ['|', ('delivery_type', '!=', 'fedex_rest'), ('fedex_rest_notify_recipient', '=', False)]}"
                />
            </field>
        </field>
    </record>

</odoo>
